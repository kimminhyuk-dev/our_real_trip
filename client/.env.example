# client/.env 예시 파일
# 이 파일을 복사해서 client/.env 를 만들고 필요한 값을 채워 넣으세요.
# CRA(react-scripts)는 REACT_APP_ 접두사가 붙은 변수만 읽습니다.
# 값 변경 후에는 npm start 를 재시작해야 반영됩니다.

# 백엔드 API 주소 (미설정 시 코드 기본값 http://localhost:5000/api 사용)
REACT_APP_API_URL=http://localhost:5000/api

# 환경 구분: 'production'이면 코드 곳곳에서 https://ourrealtrip.shop 을 서버 주소로 사용.
# 로컬 개발에서는 비워두거나 development 로 설정 (그러면 http://localhost:5000 사용)
REACT_APP_ENV=development

# Google Maps API 키 (숙소 지도 표시 기능에 필요, 없으면 지도만 동작 안 함)
REACT_APP_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
