# server/.env 예시 파일
# 이 파일을 복사해서 server/.env 를 만들고 실제 값을 채워 넣으세요.
# 실제 키/비밀번호는 절대 git에 커밋하지 마세요. (.env는 .gitignore에 포함되어 있음)

# ── 기본 실행 설정 ──────────────────────────────────────────
SERVER_PORT=5000
CLIENT_PORT=3000
CLIENT_URL=http://localhost:3000
NODE_ENV=development

# ── MongoDB (필수) ─────────────────────────────────────────
# Docker Compose의 MongoDB를 사용하는 경우 (계정: ort/ort, docker-compose.yml 기준):
#  - 로컬에서 server를 직접 실행할 때:
DB_URI=mongodb://ort:ort@localhost:27017/ort?authSource=admin
#  - server를 docker compose로 함께 실행할 때는 host를 서비스명으로 변경:
# DB_URI=mongodb://ort:ort@mongodb:27017/ort?authSource=admin

# ── JWT (필수) ─────────────────────────────────────────────
JWT_SECRET=change_me_jwt_secret
REFRESH_TOKEN_SECRET=change_me_refresh_secret
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_IN=7d

# ── 소셜 로그인 (서버 기동에 필수: 값이 비어 있으면 passport 설정에서 서버가 크래시함) ──
# 실제 소셜 로그인을 쓰지 않더라도 더미 문자열이라도 채워야 서버가 시작됩니다.
FACEBOOK_APP_ID=dummy
FACEBOOK_APP_SECRET=dummy
FACEBOOK_CALLBACK_URL=http://localhost:5000/api/auth/facebook/callback

NAVER_CLIENT_ID=dummy
NAVER_CLIENT_SECRET=dummy
NAVER_REDIRECT_URI=http://localhost:5000/api/auth/naver/callback

KAKAO_CLIENT_ID=dummy
KAKAO_CLIENT_SECRET=dummy
KAKAO_REDIRECT_URI=http://localhost:5000/api/auth/kakao/callback

GOOGLE_CLIENT_ID=dummy
GOOGLE_CLIENT_SECRET=dummy
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ── 이메일 발송 (선택: 이메일 인증/알림 기능 사용 시 필요) ──
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_app_password

# ── 포트원(아임포트) 결제 (선택: 결제/예약 검증 기능 사용 시 필요) ──
PORTONE_API_KEY=your_portone_api_key
PORTONE_API_SECRET=your_portone_api_secret
